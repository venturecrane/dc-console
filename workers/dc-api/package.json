{
  "name": "dc-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run --project unit --project harness",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply dc-main --local",
    "db:migrate:remote": "wrangler d1 migrations apply dc-main --remote"
  },
  "dependencies": {
    "hono": "^4.12.14",
    "jszip": "^3.10.1",
    "sanitize-html": "^2.17.0",
    "svix": "^1.84.1",
    "ulidx": "^2.4.1",
    "unpdf": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.13.3",
    "@cloudflare/workers-types": "^4.20250124.0",
    "@venturecrane/crane-test-harness": "^0.1.0",
    "@types/sanitize-html": "^2.16.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.1",
    "wrangler": "^4.0.0"
  }
}
